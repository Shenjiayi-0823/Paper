# Copy this file to .env. Never commit your real API key.
OPENAI_API_KEY=
# Choose a model available to your OpenAI API account that supports tool calling.
OPENAI_MODEL=gpt-4.1-mini
ARXIV_MAX_RESULTS=5
PDF_MAX_PAGES=50
PDF_MAX_BYTES=20971520
PDF_MAX_TEXT_CHARS=500000
REQUEST_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_ROUNDS=8
AGENT_TOOL_TIMEOUT_SECONDS=90
AGENT_TASK_TIMEOUT_SECONDS=300
ANALYSIS_OUTPUT_TOKENS=6000
AGENT_MAX_RESULT_CHARS=16000
AGENT_MAX_TASK_RESULT_CHARS=64000
AGENT_MAX_REPEATED_CALLS=2
AGENT_MAX_CALLS_PER_ROUND=4
# Relative paths are resolved from the project root.
DATA_DIR=data
